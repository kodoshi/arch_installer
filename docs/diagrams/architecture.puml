@startuml DALI_Architecture
!theme plain
skinparam classAttributeIconSize 0
skinparam groupInheritance 2
skinparam packageStyle rectangle
set separator none

title "DALI - Declarative ArchLinux Installer - Architecture Diagram"

package "Entry Points (cli.py)" {
    class "cli" as cli <<module>> {
        + main(): int
        + usb_init(): int
        + usb_backup(): int
        + encrypt_secrets(): int
        + decrypt_secrets(): int
        + resolve_config(environment, interactive, tui): InstallerConfig
        + validate_for_install(config)
        --
        defaults -> config.yaml -> secrets
        -> environment -> TUI
    }
}

package "Configuration (config/)" {
    class InstallerConfig <<frozen>> {
        system: SystemConfig
        packages: PackagesConfig
        storage: StorageConfig
        boot: BootConfig
        gpu: GpuConfig
        snapper: SnapperConfig
        firewall: FirewallConfig
        docker: DockerConfig
        notifications: NotificationsConfig
        sync: SyncConfig
        migration: MigrationConfig
        usb_boot: UsbBootConfig
        secrets: EncryptedSecretsConfig
        credentials: Credentials
    }

    class "loader" as loader <<module>> {
        + load_config(path): InstallerConfig
        + parse_config(raw): InstallerConfig
        --
        walks the model's type hints;
        unknown keys and wrong types fail
    }

    enum EnvVariable {
        LUKS_PASSWORD
        TARGET_DISK
        ENABLE_FIREWALL
        ...
    }

    class Environment {
        + text() / flag() / number()
        + choice() / choices() / names()
        + override(config): InstallerConfig
    }

    class "secrets_file" as secrets_file <<module>> {
        + write_encrypted_secrets(path, secrets)
    }
}

package "Interactive Setup (tui/)" {
    class "app" as tui_app <<module>> {
        + run_tui_setup(config): InstallerConfig
        --
        every screen starts on the
        inherited value
    }
    class "widgets" as widgets <<module>> {
        radio_menu / checkbox_menu
        toggle_menu / text_input
        confirm_screen / info_screen
    }
    class TextEntry {
        inherited: str
        typed: str
        + press(key): str | None
    }
}

package "Orchestration (installer.py)" {
    class Installer {
        - _config: InstallerConfig
        - _runner: CommandRunner
        + install()
        - _install_utility_scripts()
        - _write_final_config()
    }

    class Section <<frozen>> {
        label: str
        enabled: (InstallerConfig) -> bool
        executor: type[Executor]
    }

    note right of Section
        PIPELINE: migration staging, storage,
        mirrors, packages, migration restore,
        system, docker, GPU driver, kernel images,
        bootloader, USB boot, snapper,
        bootable snapshots, notifications, firewall
    end note
}

package "Executors (executors/)" {
    abstract class Executor {
        # _config: InstallerConfig
        # _runner: CommandRunner
        + {abstract} execute()
    }

    class StorageExecutor
    class MirrorsExecutor
    class PackagesExecutor
    class SystemExecutor
    class DockerExecutor
    class NvidiaDriverExecutor
    class UkiExecutor
    class BootloaderExecutor
    class SnapperExecutor
    class SnapshotBootExecutor
    class SnapshotNotificationsExecutor
    class FirewallExecutor
    class MigrationStagingExecutor
    class MigrationRestoreExecutor
    class UsbBootExecutor
    class UsbBackupExecutor
}

package "Core (core/)" {
    abstract class CommandRunner {
        + {abstract} run(command, ...): CommandExecutionResult
        + {abstract} run_as_chroot(command, ...): CommandExecutionResult
    }
    class SystemCommandRunner
    class "secrets" as crypto <<module>> {
        + encrypt_secret(plaintext, key): str
        + decrypt_secret(blob, key): str
    }
    class "log" as log <<module>> {
        + configure_logging(level)
    }
}

cli --> loader : loads
cli --> Environment : overrides
cli --> tui_app : asks (interactive)
cli --> Installer : runs
cli --> UsbBootExecutor : usb_init
cli --> UsbBackupExecutor : usb_init / usb_backup
cli --> secrets_file : encrypt_secrets
cli --> log

loader --> InstallerConfig : builds
Environment --> EnvVariable
Environment --> InstallerConfig : replace()
Environment --> crypto : unlock_secrets
secrets_file --> loader : verifies edit
cli --> crypto

tui_app --> widgets
widgets --> TextEntry
tui_app --> InstallerConfig : replace()

Installer o-- "PIPELINE" Section
Section --> Executor : instantiates
Installer --> CommandRunner

Executor <|-- StorageExecutor
Executor <|-- MirrorsExecutor
Executor <|-- PackagesExecutor
Executor <|-- SystemExecutor
Executor <|-- DockerExecutor
Executor <|-- NvidiaDriverExecutor
Executor <|-- UkiExecutor
Executor <|-- BootloaderExecutor
Executor <|--- SnapperExecutor
Executor <|--- SnapshotBootExecutor
Executor <|--- SnapshotNotificationsExecutor
Executor <|--- FirewallExecutor
Executor <|--- MigrationStagingExecutor
Executor <|--- MigrationRestoreExecutor
Executor <|--- UsbBootExecutor
Executor <|--- UsbBackupExecutor
Executor --> InstallerConfig : reads
Executor --> CommandRunner : runs commands

CommandRunner <|-- SystemCommandRunner

@enduml

@startuml DALI_Architecture
!theme plain
skinparam classAttributeIconSize 0
skinparam groupInheritance 2
skinparam packageStyle rectangle
set separator none

title "DALI - Declarative ArchLinux Installer - Architecture Diagram"

package "Entry Points (cli.py)" {
    class "cli" as cli <<module>> {
        + main() / usb_init() / usb_backup(): int
        + encrypt_secrets() / decrypt_secrets(): int
        + assemble_installer_config(environment, tui): InstallerConfig
        + validate_for_install(config)
    }
}

package "Install steps (install_steps/)" {
    enum InstallStep {
        MIGRATION_STAGING
        STORAGE
        PACKAGES
        SYSTEM
        ...
    }
    class "registry" as registry <<module>> {
        INSTALL_STEPS: dict[InstallStep, StepWiring]
        USB_BACKUP_SETTINGS
        + environment_variable_paths()
        + variable_for_setting(path)
        --
        dict order: the order steps run
        and questions are asked
    }
    class StepWiring <<frozen>> {
        config_sections: tuple[str, ...]
        settings: tuple[StepSetting, ...]
        enabled: StepCondition
        executor: type[Executor]
    }
    class StepSetting <<frozen>> {
        path: str
        environment_variable: EnvVariable | None
        question: Question | None
        asked_when: StepCondition
    }
    class "questions" as questions <<module>> {
        ChooseOne, ChooseMany, EnterText,
        EnterSecret, Switch, Choice
        --
        what to ask, never how to draw it
    }
}

package "Configuration (config/)" {
    class InstallerConfig <<frozen>> {
        system, storage, boot, packages, gpu,
        snapper, firewall, docker, notifications,
        sync, migration, usb_boot, secrets, credentials
        --
        no field defaults (UsbBootConfig waits)
    }
    class "value_precedence" as value_precedence <<module>> {
        INHERITANCE_ORDER = (ENVIRONMENT, CONFIG_FILE)
        + inherit_setting_values(values_by_source)
        + apply_tui_choices(inherited, choices)
    }
    class Environment {
        + setting_values(variable_paths): dict
        + text() / switch_is_on()
    }
    class "config_file" as config_file <<module>> {
        + config_file_setting_values(raw): dict
        + decrypted_credentials(values, key)
    }
    class "installer_config_builder" as builder <<module>> {
        + build_installer_config(values): InstallerConfig
        + read_setting_text(path, text, origin)
    }
}

package "Interactive setup (setup/)" {
    class "session" as session <<module>> {
        + run_setup(inherited, frontend, machine): answers
        --
        walks the steps, conditions,
        inherited values, summary
    }
    interface SetupFrontend {
        + switch / choose_one / choose_many
        + enter_text / keep_secret / enter_secret
        + review(rows): bool
    }
    class SystemMachineFacts {
        + disks(): tuple[Disk, ...]
    }
}

package "Curses front-end (tui/)" {
    class CursesFrontend {
        renders each question kind
    }
    class "widgets" as widgets <<module>> {
        run_list (one list engine)
        radio_menu / checkbox_menu / toggle_menu
        confirm_screen / text_input
    }
}

package "Orchestration (installer.py)" {
    class Installer {
        + install()
        --
        runs every step whose
        enabled(value) holds
    }
}

package "Executors (executors/)" {
    abstract class Executor {
        # _config: InstallerConfig
        # _runner: CommandRunner
        + {abstract} execute()
        --
        becomes StepExecutor with USB boot
    }
    class StorageStepExecutor
    class PackagesStepExecutor
    class SystemStepExecutor
    class KernelImagesStepExecutor
    class "... 10 more step executors" as more_steps
    class UsbBootExecutor
    class UsbBackupStepExecutor
}

package "Core (core/)" {
    abstract class CommandRunner {
        + {abstract} run(command, ...)
        + {abstract} run_as_chroot(command, ...)
    }
}

cli --> Environment : environment values
cli --> config_file : config.yaml values
cli --> value_precedence : inherits, TUI wins
cli --> builder : builds
cli --> registry : variable paths
cli --> CursesFrontend : run_tui_setup (interactive)
cli --> Installer : runs

Environment --> builder : reads text by the model's type
builder --> InstallerConfig : builds

registry o-- StepWiring
StepWiring o-- StepSetting
StepSetting --> questions
StepWiring --> Executor : executor

session --> registry : walks INSTALL_STEPS
session --> SetupFrontend : asks
session --> SystemMachineFacts : detected disks
CursesFrontend ..|> SetupFrontend
CursesFrontend --> session : run_setup
CursesFrontend --> widgets

Installer --> registry : runs enabled steps
Executor <|-- StorageStepExecutor
Executor <|-- PackagesStepExecutor
Executor <|-- SystemStepExecutor
Executor <|-- KernelImagesStepExecutor
Executor <|-- more_steps
Executor <|--- UsbBootExecutor
Executor <|--- UsbBackupStepExecutor
Executor --> InstallerConfig : reads
Executor --> CommandRunner : runs commands

@enduml
